# ---------------------------------------------------------------------------
# PicPool Konfiguration
# Kopieren nach .env und anpassen. .env gehoert NIEMALS ins Repo.
# ---------------------------------------------------------------------------

# --- Netzwerk ---------------------------------------------------------------
PICPOOL_PORT=8080
PICPOOL_BIND=0.0.0.0

# Oeffentliche Basis-URL. Wird fuer Links und QR-Codes verwendet.
# MUSS ohne abschliessenden Slash angegeben werden.
PICPOOL_PUBLIC_URL=https://picpool.example.de

# Reverse-Proxy, dem X-Forwarded-For geglaubt wird. Eng fassen!
# Bei DSM-Reverse-Proxy in der Regel das Docker-Gateway.
# Leer lassen = kein Proxy, Client-IP wird direkt verwendet.
PICPOOL_TRUST_PROXY=172.16.0.0/12

# Subnetze, die als "lokales Netz" gelten. Nur diese bekommen - sofern
# pro Album aktiviert - Originalaufloesung direkt in der Galerie angezeigt.
PICPOOL_LAN_CIDRS=192.168.1.0/24

# --- Daten ------------------------------------------------------------------
# Im Container das einzige gemountete Verzeichnis.
PICPOOL_DATA_DIR=/data

# --- Secrets ----------------------------------------------------------------
# 32 Byte base64. Erzeugen mit:  openssl rand -base64 32
# Bei einer neuen Installation frei waehlbar, danach unveraenderlich.
# Verschluesselt Share-Tokens und TOTP-Secrets at rest und signiert Sessions.
# Achtung: Dieser Schluessel darf NICHT im selben Backup liegen wie die
# Datenbank - sonst ist die Verschluesselung wirkungslos.
PICPOOL_SECRET_KEY=

# --- Limits -----------------------------------------------------------------
PICPOOL_MAX_FILE_BYTES=5368709120
PICPOOL_MAX_IMAGE_PIXELS=200000000
PICPOOL_UPLOAD_RATE_PER_IP_PER_MIN=120
PICPOOL_LOGIN_RATE_PER_IP_PER_MIN=10

# --- Verarbeitung -----------------------------------------------------------
PICPOOL_WORKER_CONCURRENCY=2
PICPOOL_FFMPEG_PATH=ffmpeg
PICPOOL_FFPROBE_PATH=ffprobe

# Derivat-Kantenlaengen in Pixeln
PICPOOL_THUMB_SIZE=320
PICPOOL_PREVIEW_SIZE=2048

# --- Betrieb ----------------------------------------------------------------
PICPOOL_LOG_LEVEL=info

# --- Nur fuer docker-compose ------------------------------------------------
# Host-Pfad des gemeinsamen Ordners auf der NAS.
PICPOOL_HOST_DATA=/volume1/picpool

# Adresse der NAS, auf der der Port veroeffentlicht wird.
#   127.0.0.1  nur die NAS selbst - richtig, sobald der Reverse Proxy steht
#   0.0.0.0    auch aus dem Heimnetz per http://<nas-ip>:8080 erreichbar
PICPOOL_HOST_BIND=127.0.0.1

# UID/GID des dedizierten DSM-Benutzers. Ermitteln mit:  id picpool
# Damit gehoeren die abgelegten Dateien diesem Benutzer und sind im
# File Station normal sichtbar und verschiebbar.
PICPOOL_UID=1027
PICPOOL_GID=100
