{
  "name": "picpool",
  "version": "0.1.0",
  "private": true,
  "description": "Selbstgehostetes Foto-Einsammeln fuer Events",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/upload",
    "apps/gallery",
    "apps/admin"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/upload && npm run build --workspace apps/gallery && npm run build --workspace apps/admin && npm run build --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:worker": "npm run dev:worker --workspace apps/server",
    "dev:lan": "node scripts/dev-lan.mjs"
  }
}
